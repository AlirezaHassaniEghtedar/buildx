# ── BotForge environment (نمونه) ── کپی کن به deploy/.env
COMPOSE_PROJECT_NAME=botforge
SECRET_KEY=                                  # حداقل ۳۲ بایت: python -c "import secrets; print(secrets.token_urlsafe(48))"
FERNET_KEY=                                    # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ACCESS_TOKEN_EXPIRE_MINUTES=43200
ENV=prod                                       # dev | prod
SQL_ECHO=false                                 # چاپ SQL فقط برای دیباگ

POSTGRES_USER=botforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=botforge
DATABASE_URL=postgresql+asyncpg://botforge:change-me@db:5432/botforge

# LLM: هر سرویس OpenAI-compatible؛ MockLLM وقتی کلید خالی باشد
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_SMART=gpt-4o-mini
LLM_MODEL_FAST=gpt-4o-mini
MAX_COST_PER_SESSION_USD=2.0
LOGFIRE_TOKEN=

# حداکثر طول توکن بات در بایت (فیله: ۲۰۰)
TOKEN_MAX_BYTES=200

# وب
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
